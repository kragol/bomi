# Maintainer: kragol <4834960+kragol@users.noreply.github.com>
# Contributor: Taegil Bae <esrevinu@gmail.com>
# Contributor: xylosper <darklin20@gmail.com>
# Contributor: willemw <willemw12@gmail.com>

# makepkg fetches from _repo, so only *committed* work ends up in the package.
# Point _repo at a local checkout (file:///path/to/bomi) if you want to package
# work in progress -- commit it there first.
_repo=https://github.com/kragol/bomi
_branch=master

_pkgbase=bomi
pkgname=$_pkgbase-git
pkgver=0.9.11.r41.g408e0569
pkgrel=1
# The AUR bomi-git sits at 0.9.11.r65.*, and this fork's commit count restarts
# lower, so without an epoch pacman would consider it a downgrade and never
# offer it as an update.
epoch=1
pkgdesc="Powerful and easy-to-use GUI multimedia player based on mpv (kragol fork, git version)"
arch=('x86_64')
url="https://github.com/kragol/bomi"
license=('GPL2')

# What the packaged binary links against (readelf -d on pkg/.../usr/bin/bomi;
# makepkg's --as-needed drops everything bomi does not call itself). Audio
# outputs, DVD, Blu-ray, CDDA and subtitle rendering are libmpv's business now,
# and the mpv package carries those dependencies.
depends=('gcc-libs' 'glib2' 'glibc' 'libchardet' 'libgl' 'libxcb'
         'qt5-base' 'qt5-declarative' 'qt5-x11extras'
         'smbclient' 'systemd-libs' 'zlib'
         # Loaded at runtime, so they show up in no ELF header: QtQuick.Controls
         # 1.x for the skins, and the SVG image plugin for SVG icons.
         'qt5-quickcontrols' 'qt5-svg'
         # The system libmpv, and the FFmpeg libraries bomi also calls directly.
         # Declared by soname: makepkg turns these into versioned dependencies,
         # so pacman blocks an mpv or ffmpeg soname bump instead of silently
         # breaking bomi -- rebuild this package when one happens.
         'libmpv.so' 'libavcodec.so' 'libavutil.so')

makedepends=('git' 'pkgconf' 'qt5-tools' 'mesa')

optdepends=('yt-dlp: streaming website support including YouTube'
            'libaacs: AACS decryption for Blu-ray support'
            'libbdplus: BD+ decryption for Blu-ray support')

provides=("$_pkgbase")
conflicts=("$_pkgbase" 'cmplayer')

# !lto: bomi's objects already get -flto from Qt's mkspec, which sets
# CONFIG+=ltcg on this distribution, matching a plain `make`; makepkg's own
# -flto=auto on top adds nothing. !debug: a debug split package has not been
# tried since the vendored FFmpeg and mpv went away.
options=('!lto' '!debug')

source=("$_pkgbase::git+$_repo#branch=$_branch")
sha256sums=('SKIP')

# The GitHub repository carries no tags, so `git describe` has nothing to work
# with in makepkg's clone. Count from the commit v0.9.11 points at instead, which
# yields exactly what describe gave against a tagged local clone.
_basever=0.9.11
_basecommit=e9d6b9d299095492edb3f66628db0819bfde170a

pkgver() {
  cd "$srcdir/$_pkgbase"
  printf "%s.r%s.g%s" "$_basever" \
    "$(git rev-list --count $_basecommit..HEAD)" \
    "$(git rev-parse --short=8 HEAD)"
}

build() {
  cd "$srcdir/$_pkgbase"

  # bomi builds against the system libmpv and FFmpeg; nothing is vendored, and
  # hardware decoding is mpv's business. These features are autodetected by
  # default -- pinning them keeps the package's dependencies from drifting
  # with whatever is installed here.
  ./configure \
    --prefix=/usr \
    --actiondir=/usr/share/solid/actions \
    --enable-jack \
    --enable-pulseaudio \
    --enable-cdda \
    --enable-samba \
    --enable-systemd

  make
}

package() {
  cd "$srcdir/$_pkgbase"
  make DEST_DIR="$pkgdir" install

  install -Dm644 COPYING.txt "$pkgdir/usr/share/licenses/$pkgname/COPYING.txt"
  install -Dm644 GPL.txt "$pkgdir/usr/share/licenses/$pkgname/GPL.txt"
  install -Dm644 MPL.txt "$pkgdir/usr/share/licenses/$pkgname/MPL.txt"
}
