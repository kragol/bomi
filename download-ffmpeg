#! /bin/bash
set -e

# FFmpeg is pinned to 4.0.1: the in-tree mpv carries API fixes written against
# ffmpeg 4.0 (demux_lavf.c, vd_lavc.c, encode_lavc.c and friends), so building
# against anything much older or newer fights those patches.
version=4.0.1
url=https://www.ffmpeg.org/releases/ffmpeg-${version}.tar.gz
out=ffmpeg.tar.gz

install -d src

if [ -d src/ffmpeg ]; then
  echo "src/ffmpeg already present, skipping download."
  echo "Remove it first if you want to re-download ffmpeg ${version}."
  exit 0
fi

echo "Downloading ${url}"
curl -fL -o "src/${out}" "${url}"

cd src
tar xzf "${out}"
mv "ffmpeg-${version}" ffmpeg
rm "${out}"
echo "Unpacked ffmpeg ${version} into src/ffmpeg."
